{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["GIT_AUTH_TOKEN", "GIT_CREDENTIALS"],
  "tasks": {
    "generate": {
      "inputs": ["../../target/idl/*.json", "codama.config.mjs"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "@elisym/checkout#build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "CHECKOUT_ORIGIN",
        "VERCEL_ENV",
        "VERCEL_URL",
        "VITE_SOLANA_RPC_URL_MAINNET",
        "VITE_SOLANA_RPC_URL_DEVNET"
      ]
    }
  }
}
