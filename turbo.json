{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["GIT_AUTH_TOKEN", "GIT_CREDENTIALS"],
  "tasks": {
    "generate": {
      "inputs": ["../../target/idl/*.json", "codama.config.mjs"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "@elisym/docs#build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".vercel/output/**"],
      "env": ["VERCEL"]
    },
    "@elisym/merchant-node#test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "../docs/pages/**", "../../examples/demo-store/README.md"]
    },
    "@elisym/merchant-admin#build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../merchant-node/src/admin/**",
        "../merchant-node/src/constants.ts",
        "../merchant-node/src/order-rules.ts",
        "../merchant-node/src/listing-reads.ts",
        "../merchant-node/src/signature.ts",
        "../merchant-node/package.json",
        "../merchant-node/tests/admin/fixtures.ts",
        "../merchant-node/tsconfig.json"
      ]
    },
    "@elisym/merchant-admin#typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../merchant-node/src/admin/**",
        "../merchant-node/src/constants.ts",
        "../merchant-node/src/order-rules.ts",
        "../merchant-node/src/listing-reads.ts",
        "../merchant-node/src/signature.ts",
        "../merchant-node/package.json",
        "../merchant-node/tests/admin/fixtures.ts"
      ]
    },
    "@elisym/merchant-admin#test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../merchant-node/src/admin/**",
        "../merchant-node/src/constants.ts",
        "../merchant-node/src/order-rules.ts",
        "../merchant-node/src/listing-reads.ts",
        "../merchant-node/src/signature.ts",
        "../merchant-node/package.json",
        "../merchant-node/tests/admin/fixtures.ts",
        "../merchant-node/tsconfig.json",
        "../merchant-node/src/cli.ts"
      ]
    },
    "@elisym/merchant-landing#build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "../merchant-admin/scripts/build-checks.ts"]
    },
    "@elisym/merchant-landing#test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../merchant-node/src/constants.ts",
        "../merchant-node/README.md",
        "../docs/pages/commerce/quickstart.mdx",
        "../merchant-node/src/cli.ts",
        "../docs/pages/commerce/**"
      ]
    },
    "@elisym/checkout#build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "CHECKOUT_ORIGIN",
        "VERCEL_ENV",
        "VERCEL_URL",
        "VITE_SOLANA_RPC_URL_MAINNET",
        "VITE_SOLANA_RPC_URL_DEVNET"
      ]
    },
    "@elisym/merchant-landing#typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../merchant-admin/scripts/build-checks.ts"]
    }
  }
}
