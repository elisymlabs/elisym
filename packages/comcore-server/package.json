{
  "name": "@elisym/comcore-server",
  "version": "0.1.0",
  "private": true,
  "description": "ComCore server: gateway session tickets, agent workers over the relay, and (from phase 3) the database, connectors and admin API.",
  "license": "MIT",
  "author": "elisym labs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
