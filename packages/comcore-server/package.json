    "nostr-tools": "~2.23.0",
    "ws": "~8.20.0",
    "zod": "~3.25.0"
  },
  "devDependencies": {
    "@elisym/comcore-widget": "~0.1.0",
    "@types/node": "~25.5.0",
    "@types/ws": "~8.18.1",
    "tsup": "~8.4.0",
    "typescript": "~5.7.0",
    "vitest": "~3.2.6"
  },
  "engines": {
    "node": ">=20"
  }
}
