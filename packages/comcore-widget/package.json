{
  "name": "@elisym/comcore-widget",
  "version": "0.1.0",
  "private": true,
  "description": "ComCore browser chat widget: a shopping assistant for any store's site, over Nostr.",
  "license": "MIT",
  "author": "elisym labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/elisymlabs/elisym.git",
    "directory": "packages/comcore-widget"
  },
  "type": "module",
  "sideEffects": [
    "./src/widget.ts",
    "./dist/widget.js"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./widget.js": "./dist/widget.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && bun scripts/check-size.ts",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/ tests/ scripts/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@elisym/comcore": "~0.1.0",
    "@elisym/commerce": "~0.14.0",
    "decimal.js-light": "~2.5.1",
    "nostr-tools": "~2.23.0",
    "zod": "~3.25.0"
  },
  "devDependencies": {
    "@types/node": "~25.5.0",
    "happy-dom": "~20.14.5",
    "tsup": "~8.4.0",
    "typescript": "~5.7.0",
    "vitest": "~3.2.6"
  },
  "engines": {
    "node": ">=20"
  }
}
