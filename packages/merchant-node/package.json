{
  "name": "@elisym/merchant-node",
  "version": "0.9.1",
  "description": "elisym merchant node: self-hosted store for the elisym checkout - takes orders over Nostr, verifies payments, completes orders.",
  "keywords": [
    "checkout",
    "commerce",
    "elisym",
    "nostr",
    "payments",
    "solana",
    "usdc"
  ],
  "homepage": "https://github.com/elisymlabs/elisym",
  "bugs": {
    "url": "https://github.com/elisymlabs/elisym/issues"
  },
  "license": "MIT",
  "author": "elisym labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/elisymlabs/elisym.git",
    "directory": "packages/merchant-node"
  },
  "bin": {
    "elisym-merchant": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && bun scripts/check-admin.ts",
    "test": "vitest run && bun run test:bun",
    "test:bun": "bun ./tests/bun/secret-box-smoke.ts && bun ./tests/bun/webhook-redirect-smoke.ts && bun ./tests/bun/webhook-verify-smoke.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.admin.json",
    "lint": "oxlint src/ tests/ scripts/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@elisym/commerce": "~0.9.0",
    "@elisym/pay-core": "~0.1.3",
    "@solana-program/token": "~0.14.0",
    "@solana/kit": "~6.8.0",
    "decimal.js-light": "~2.5.1",
    "nostr-tools": "~2.23.0",
    "yaml": "~2.8.3",
    "zod": "~3.25.0"
  },
  "devDependencies": {
    "@types/node": "~25.5.0",
    "happy-dom": "~20.14.5",
    "tsup": "~8.4.0",
    "typescript": "~5.7.0",
    "vitest": "~3.2.6"
  },
  "engines": {
    "node": ">=22.4"
  }
}
