    "@solana-program/token": "~0.14.0",
    "@solana/kit": "~6.8.0",
    "decimal.js-light": "~2.5.1",
    "nostr-tools": "~2.23.0",
    "preact": "~10.29.8"
  },
  "devDependencies": {
    "@types/node": "~25.5.0",
    "fake-indexeddb": "~6.2.5",
    "happy-dom": "~20.14.5",
    "typescript": "~5.7.0",
    "vite": "~6.4.0",
    "vitest": "~3.2.6"
  }
