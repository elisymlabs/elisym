{
  "name": "@elisym/react",
  "version": "0.1.0",
  "description": "React component for the elisym checkout: the <elisym-buy> widget, pinned to the v3 loader.",
  "keywords": [
    "checkout",
    "elisym",
    "payments",
    "react",
    "solana",
    "usdc"
  ],
  "homepage": "https://docs.elisym.network/commerce/widget",
  "license": "MIT",
  "author": "elisym labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/elisymlabs/elisym.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./constants": {
      "import": {
        "types": "./dist/constants.d.ts",
        "default": "./dist/constants.js"
      },
      "require": {
        "types": "./dist/constants.d.cts",
        "default": "./dist/constants.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/ tests/",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "~25.5.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "happy-dom": "~20.14.5",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "tsup": "~8.4.0",
    "typescript": "~5.7.0",
    "vitest": "~3.2.6"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  }
}
