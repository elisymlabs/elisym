{
  "name": "@elisym/commerce",
  "version": "0.1.0",
  "description": "elisym commerce protocol: signed payout addresses, store authorization, Nostr product listings, private NIP-17 orders, and offer verification.",
  "keywords": [
    "commerce",
    "nip-17",
    "nip-99",
    "nostr",
    "payments",
    "solana",
    "typescript"
  ],
  "homepage": "https://github.com/elisymlabs/elisym",
  "license": "MIT",
  "author": "elisym labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/elisymlabs/elisym.git",
    "directory": "packages/commerce"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@elisym/pay-core": "~0.1.0",
    "@noble/curves": "~2.0.1",
    "@noble/hashes": "~2.0.1",
    "@scure/base": "~2.0.0",
    "zod": "~3.25.0"
  },
  "devDependencies": {
    "@solana-program/memo": "~0.11.0",
    "@solana-program/system": "~0.12.0",
    "@solana-program/token": "~0.14.0",
    "@solana/kit": "~6.8.0",
    "@types/node": "~25.5.0",
    "decimal.js-light": "~2.5.1",
    "nostr-tools": "~2.23.0",
    "tsup": "~8.4.0",
    "typescript": "~5.7.0",
    "vitest": "~3.2.6"
  },
  "peerDependencies": {
    "@solana-program/memo": "~0.11.0",
    "@solana-program/system": "~0.12.0",
    "@solana-program/token": "~0.14.0",
    "@solana/kit": "~6.8.0",
    "decimal.js-light": "~2.5.0",
    "nostr-tools": "~2.23.0"
  },
  "engines": {
    "node": ">=20"
  }
}
