      "prompt": {
        "default": "",
        "description": "Optional text instruction sent alongside the file (e.g. how to edit an image: "make it night", "add a hat"). It rides inline (NIP-44 encrypted) in the job event while the file travels peer-to-peer via iroh. The single attachment slot holds the file, so the prompt cannot spill to a second transfer - keep it short.",
        "maxLength": 100000,
        "type": "string",
      },
      "provider_npub": {
        "type": "string",
      },
      "timeout_secs": {
        "default": 300,
        "maximum": 600,
        "minimum": 1,
        "type": "integer",
      },
    },
    "required": [
      "input_path",
      "provider_npub",
    ],
    "type": "object",
  },
  "submit_diff_review": {
    "additionalProperties": false,
    "properties": {
      "allow_outside_cwd": {
        "default": false,
        "description": "Allow reviewing a repo outside the MCP server working directory. Off by default - the diff is forwarded to the provider before payment and is invisible in the transcript, so the repo is confined to the working dir subtree unless this is set. Sensitive paths (secret keys, .env, SSH/keypair, ~/.elisym, /proc) are always refused.",
        "type": "boolean",
      },
      "base": {
        "description": "Optional base ref (branch, tag, SHA). When set, diffs \${base}...HEAD. When omitted, auto-detects working-tree vs main/master/origin-HEAD.",
        "maxLength": 200,
        "type": "string",
      },
      "capability": {
        "default": "review",
        "description": "Capability tag advertised by the reviewer. Override if not "review".",
        "maxLength": 64,
        "minLength": 1,
        "type": "string",
      },
      "kind_offset": {
        "default": 100,
        "maximum": 999,
        "minimum": 0,
        "type": "integer",
      },
      "max_price_lamports": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer",
      },
      "prompt": {
        "default": "",
        "description": "Optional instructions prepended above the diff (e.g. "focus on auth flow").",
        "maxLength": 100000,
        "type": "string",
      },
      "provider_npub": {
        "type": "string",
      },
      "repo_path": {
        "default": ".",
        "description": "Path to the git repo. Absolute or relative to the MCP server's working directory.",
        "maxLength": 4096,
        "minLength": 1,
        "type": "string",
      },
      "session_id": {
        "anyOf": [
          {
            "const": "new",
            "type": "string",
          },
          {
            "const": "none",
            "type": "string",
          },
          {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string",
          },
        ],
        "description": "Conversation control. Omit for automatic session management (providers advertising context support get a conversation auto-started on first contact; an ongoing conversation triggers a continue/new/one-off question before anything is published). Pass "new" to force a fresh conversation, "none" to force a stateless one-off, or a session_id from a previous result to continue that conversation. The provider answers with the conversation context of prior exchanges under the same id.",
      },
      "timeout_secs": {
        "default": 300,
        "maximum": 600,
        "minimum": 1,
        "type": "integer",
      },
    },
    "required": [
      "provider_npub",
    ],
    "type": "object",
  },
  "submit_feedback": {
    "additionalProperties": false,
    "properties": {
      "job_event_id": {
        "description": "Event ID returned by submit_and_pay_job, buy_capability, or create_job.",
        "maxLength": 128,
        "minLength": 1,
        "type": "string",
      },
      "provider_npub": {
        "description": "Provider npub. Optional when the job is in local history (.customer-history.json); required when feedback is submitted for a job submitted from outside this MCP.",
        "type": "string",
      },
      "rating": {
        "enum": [
          "positive",
          "negative",
        ],
        "type": "string",
      },
    },
    "required": [
      "job_event_id",
      "rating",
    ],
    "type": "object",
  },
  "switch_agent": {
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
      },
    },
    "required": [
      "name",
    ],
    "type": "object",
  },
  "verify_agent_identities": {
    "additionalProperties": false,
    "properties": {
      "agent_npub": {
        "description": "Agent npub (bech32 nostr identifier, starts with \`npub1...\`).",
        "minLength": 1,
        "type": "string",
      },
    },
    "required": [
      "agent_npub",
    ],
    "type": "object",
  },
  "withdraw": {
    "additionalProperties": false,
    "properties": {
      "address": {
        "description": "Destination Solana address (base58). Must be a valid address.",
        "type": "string",
      },
      "amount": {
        "description": "Amount in units of the selected asset as a decimal string (e.g. "0.5" for 0.5 SOL, "1.25" for 1.25 USDC), or the literal "all".",
        "type": "string",
      },
      "amount_sol": {
        "description": "Legacy alias of \`amount\` for SOL withdrawals. Amount in SOL as a decimal string, or the literal "all". Prefer \`amount\` + \`token\` for new callers.",
        "type": "string",
      },
      "nonce": {
        "description": "Confirmation nonce from a previous preview call. Omit to request a preview.",
        "type": "string",
      },
      "token": {
        "description": "Asset to withdraw ('lsm' is mainnet-only). Defaults to 'sol' for back-compat.",
        "enum": [
          "sol",
          "usdc",
          "lsm",
        ],
        "type": "string",
      },
    },
    "required": [
      "address",
    ],
    "type": "object",
  },
}
`;
